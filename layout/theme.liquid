<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title }}{% if current_tags %} tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} - {{ shop.name }}{% endunless %}</title>
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">
    <meta name="theme-color" content="{{ settings.accent_color | default: '#4d955f' }}">
    {{ content_for_header }}
    {{ 'trefelle-theme.css' | asset_url | stylesheet_tag }}
    {% if settings.accent_color %}
      <style>:root{--color-accent: {{ settings.accent_color }};}</style>
    {% endif %}
    <script src="{{ 'trefelle-theme.js' | asset_url }}" defer></script>
  </head>
  <body>
    {% section 'header' %}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
    {% render 'cookie-banner' %}
    {% section 'footer' %}
    {% render 'policy-modal' %}
  </body>
</html>
