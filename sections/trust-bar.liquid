<section class="trust-bar" aria-label="Store assurances">
  <div data-animate>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
    <div>
      <strong>Clear product details</strong>
      <span>Prices, options, photos, and shipping expectations stay visible before checkout.</span>
    </div>
  </div>
  <div data-animate>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>
    <div>
      <strong>Broad everyday finds</strong>
      <span>Trefelle can carry practical home, tech, travel, pet, auto, and accessory products when they pass quality checks.</span>
    </div>
  </div>
  <div data-animate>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg>
    <div>
      <strong>Shop with context</strong>
      <span>Privacy, shipping, terms, and no-return policies are available without leaving the page.</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "settings": []
}
{% endschema %}
