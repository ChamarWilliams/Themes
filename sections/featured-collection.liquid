<section class="featured-products">
  <div class="section-heading">
    <h2>{{ section.settings.heading }}</h2>
    <a href="{{ routes.collections_url }}">View all</a>
  </div>
  {% assign selected_collection = section.settings.collection %}
  <div class="product-grid">
    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      {% for product in selected_collection.products limit: 8 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% elsif collections.all.products_count > 0 %}
      {% for product in collections.all.products limit: 8 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      <div class="empty-state">
        <p class="eyebrow">Inventory in progress</p>
        <h2>No products available yet</h2>
        <p>The storefront is set up for convenience first. New Trefelle products will show here when they are ready to browse.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular practical finds"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ]
}
{% endschema %}
