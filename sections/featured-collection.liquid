<section id="FeaturedProducts" class="featured-products">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Start here</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <a class="section-link" href="{{ routes.all_products_collection_url }}">View all products</a>
  </div>
  {% assign selected_collection = section.settings.collection %}
  <div class="product-grid">
    {% assign seen_product_titles = '' %}
    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      {% assign product_count = selected_collection.products_count %}
      {% for product in selected_collection.products limit: 12 %}
        {% assign product_key = product.title | downcase | replace: '(new)', '' | replace: 'new ', '' | replace: '1pcs', '' | replace: '1pc', '' | replace: '2pcs', '' | replace: '2pc', '' | replace: '3pcs', '' | replace: '3pc', '' | replace: '10pcs', '' | replace: '10pc', '' | replace: 'for dogs cats', 'pet' | replace: 'for dog cat', 'pet' | handleize | truncate: 72, '' | prepend: '|' | append: '|' %}
        {% unless seen_product_titles contains product_key %}
          {% render 'product-card', product: product %}
          {% assign seen_product_titles = seen_product_titles | append: product_key %}
        {% endunless %}
      {% endfor %}
    {% elsif collections.all.products_count > 0 %}
      {% assign product_count = collections.all.products_count %}
      {% for product in collections.all.products limit: 12 %}
        {% assign product_key = product.title | downcase | replace: '(new)', '' | replace: 'new ', '' | replace: '1pcs', '' | replace: '1pc', '' | replace: '2pcs', '' | replace: '2pc', '' | replace: '3pcs', '' | replace: '3pc', '' | replace: '10pcs', '' | replace: '10pc', '' | replace: 'for dogs cats', 'pet' | replace: 'for dog cat', 'pet' | handleize | truncate: 72, '' | prepend: '|' | append: '|' %}
        {% unless seen_product_titles contains product_key %}
          {% render 'product-card', product: product %}
          {% assign seen_product_titles = seen_product_titles | append: product_key %}
        {% endunless %}
      {% endfor %}
    {% else %}
      <div class="empty-state">
        <p class="eyebrow">Inventory in progress</p>
        <h2>No products available yet</h2>
        <p>The storefront is set up for convenience first. New Trefelle products will show here when they are ready to browse.</p>
      </div>
    {% endif %}
  </div>
  {% if product_count > 12 %}
    <div class="browse-more">
      <a class="button-primary button-large" href="{{ routes.all_products_collection_url }}">Browse every product</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular practical finds"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ]
}
{% endschema %}
