<footer class="site-footer">
  <div>
    <strong>{{ settings.brand_name | default: shop.name }}</strong>
    <p>Curated product drafts and practical everyday finds.</p>
  </div>
  <nav aria-label="Footer">
    <a href="{{ routes.search_url }}">Search</a>
    <a href="{{ routes.collections_url }}">All collections</a>
    <a href="{{ routes.cart_url }}">Cart</a>
    {% if customer %}
      <a href="{{ routes.account_url }}">Account</a>
    {% else %}
      <a href="{{ routes.account_login_url }}">Sign in</a>
    {% endif %}
  </nav>
  <nav class="policy-links" aria-label="Policies">
    <a href="/policies/privacy-policy">Privacy</a>
    <a href="/policies/refund-policy">Returns</a>
    <a href="/policies/shipping-policy">Shipping</a>
    <a href="/policies/terms-of-service">Terms</a>
    <a href="/pages/contact">Contact</a>
  </nav>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
