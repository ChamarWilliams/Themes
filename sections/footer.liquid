<footer class="site-footer">
  <div>
    <strong>{{ settings.brand_name | default: 'Trefelle' }}</strong>
    <p>Premium home goods, softly curated for everyday living.</p>
  </div>
  <nav aria-label="Footer">
    <a href="{{ routes.search_url }}">Search</a>
    <a href="{{ routes.collections_url }}">All collections</a>
    <a href="{{ routes.cart_url }}">Cart</a>
    {% if customer %}
      <a href="{{ routes.account_url }}">Account</a>
    {% else %}
      <a href="{{ routes.account_login_url }}">Sign in</a>
    {% endif %}
  </nav>
  <nav class="policy-links" aria-label="Policies">
    <a href="#policy-privacy" data-policy-open="privacy">Privacy</a>
    <a href="#policy-no-returns" data-policy-open="no-returns">No Returns</a>
    <a href="#policy-shipping" data-policy-open="shipping">Shipping</a>
    <a href="#policy-terms" data-policy-open="terms">Terms</a>
    <a href="#policy-legal" data-policy-open="legal">Legal Notice</a>
    <a href="#policy-contact" data-policy-open="contact">Contact</a>
  </nav>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
