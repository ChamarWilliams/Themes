<section class="hero-commerce">
  <div class="hero-media">
    {% if settings.hero_image != blank %}
      {{ settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', sizes: '100vw', widths: '600,900,1200,1800', alt: settings.brand_name }}
    {% else %}
      <div class="hero-fallback"></div>
    {% endif %}
  </div>
  <div class="hero-content">
    <img class="hero-mark" src="{{ 'trefelle-logo-mark.png' | asset_url }}" alt="" loading="eager">
    <p class="eyebrow">Premium home goods</p>
    <h1>{{ settings.brand_name | default: 'Trefelle' }}</h1>
    <p>Simple everyday finds with clear prices, visible policies, and an easy path from browsing to checkout.</p>
    <div class="hero-actions">
      <a class="button-primary button-large" href="{{ routes.all_products_collection_url }}">Shop all products</a>
      <a class="button-secondary button-large" href="#FeaturedProducts">See popular finds</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Commerce hero",
  "settings": []
}
{% endschema %}
