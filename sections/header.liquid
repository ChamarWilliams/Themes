<header class="site-header">
  <div class="announcement">{{ settings.announcement_text }}</div>
  <div class="header-shell">
    <a class="brand brand-lockup" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: 'Trefelle' }}">
      <img src="{{ 'trefelle-logo-mark.png' | asset_url }}" alt="" loading="eager">
      <span>{{ settings.brand_name | default: 'Trefelle' }}</span>
    </a>
    <form class="search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search home goods">
      <button type="submit">Search</button>
    </form>
    <nav class="header-actions" aria-label="Store">
      <button class="drawer-trigger" type="button" data-category-drawer-open aria-controls="CategoryDrawer" aria-expanded="false">Categories</button>
      {% if customer %}
        <a href="{{ routes.account_url }}">Account</a>
      {% else %}
        <a href="{{ routes.account_login_url }}">Sign in</a>
      {% endif %}
      <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
    </nav>
  </div>
</header>

<div class="drawer-overlay" data-category-drawer-close hidden></div>
<aside id="CategoryDrawer" class="category-drawer" aria-label="Categories and shortcuts" aria-hidden="true">
  <div class="drawer-header">
    <div>
      <p class="eyebrow">Quick browse</p>
      <h2>Categories</h2>
    </div>
    <button class="drawer-close" type="button" data-category-drawer-close aria-label="Close categories">Close</button>
  </div>

  <form class="drawer-search" action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" placeholder="Search products">
    <button type="submit">Go</button>
  </form>

  {% assign category_menu = section.settings.category_menu %}
  {% if category_menu != blank and category_menu.links.size > 0 %}
    <nav class="drawer-nav" aria-label="Category menu">
      {% for link in category_menu.links %}
        <a href="{{ link.url }}">
          <span>{{ link.title }}</span>
          <small>Browse</small>
        </a>
      {% endfor %}
    </nav>
  {% else %}
    <nav class="drawer-nav" aria-label="Category shortcuts">
      <a href="{{ routes.collections_url }}"><span>All collections</span><small>Browse</small></a>
      <a href="{{ routes.search_url }}?q=travel"><span>Travel</span><small>Find</small></a>
      <a href="{{ routes.search_url }}?q=office"><span>Office</span><small>Find</small></a>
      <a href="{{ routes.search_url }}?q=cable"><span>Cable management</span><small>Find</small></a>
      <a href="{{ routes.search_url }}?q=organizer"><span>Organizers</span><small>Find</small></a>
    </nav>
  {% endif %}

  <div class="drawer-quick-actions">
    <a href="{{ routes.cart_url }}">View cart</a>
    {% if customer %}
      <a href="{{ routes.account_url }}">Orders</a>
    {% else %}
      <a href="{{ routes.account_login_url }}">Optional sign in</a>
    {% endif %}
  </div>
  <p class="drawer-note">Your cart can stay saved in this browser. Sign in is optional and helps with order history.</p>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Category drawer menu"
    }
  ]
}
{% endschema %}
