<section class="policy-page">
  <div class="policy-shell">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <div class="policy-richtext">
      {{ section.settings.body }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Policy content",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Store policy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Policy"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>This policy is a starter template and should be reviewed before publishing.</p>"
    }
  ]
}
{% endschema %}
