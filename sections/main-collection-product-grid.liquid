<section class="collection-page">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Browse</p>
      <h1>{{ collection.title | default: 'All products' }}</h1>
    </div>
    <form class="sort-form">
      <label for="SortBy">Sort</label>
      <select id="SortBy" name="sort_by">
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    </form>
  </div>
  <div class="product-grid">
    {% assign seen_product_titles = '' %}
    {% for product in collection.products %}
      {% assign product_key = product.title | handleize | prepend: '|' | append: '|' %}
      {% unless seen_product_titles contains product_key %}
        {% render 'product-card', product: product %}
        {% assign seen_product_titles = seen_product_titles | append: product_key %}
      {% endunless %}
    {% else %}
      <div class="empty-state">
        <p class="eyebrow">Coming soon</p>
        <h2>No products available yet</h2>
        <p>Trefelle is being prepared for carefully selected everyday finds. Products will appear here once the first listings are ready.</p>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "settings": []
}
{% endschema %}
