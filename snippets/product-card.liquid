<article class="product-card">
  <a class="product-card-media" href="{{ product.url }}">
    {% if product.featured_media %}
      {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw', widths: '250,400,600', alt: product.title }}
    {% endif %}
  </a>
  <div class="product-card-body">
    <a class="product-title" href="{{ product.url }}">{{ product.title }}</a>
    {% render 'price', product: product %}
    {% if product.type != blank %}
      <p>{{ product.type }}</p>
    {% endif %}
    {% assign card_variant = product.selected_or_first_available_variant %}
    <div class="product-card-actions">
      <a class="button-secondary product-details-button" href="{{ product.url }}">View item</a>
      {% if product.available and card_variant %}
        <form action="{{ routes.cart_add_url }}" method="post">
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
          <button class="button-primary quick-add-button" type="submit">Add to cart</button>
        </form>
      {% else %}
        <span class="sold-out-note">Sold out</span>
      {% endif %}
    </div>
  </div>
</article>
